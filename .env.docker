# ─────────────────────────────────────────────────────────────────
# .env.docker — copy this to .env before running docker compose
#
#   cp .env.docker .env
#   docker compose up -d
#
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────────

# Backend
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
CLIENT_URL=http://localhost

# Frontend build (used by docker compose --profile build)
VITE_API_URL=http://localhost/graphql
