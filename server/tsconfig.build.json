{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/agents/**",
    "src/__tests__/**",
    "src/services/anomalyService.ts",
    "src/services/batchService.ts",
    "src/services/landedCostService.ts",
    "src/services/paymentReconciliationService.ts",
    "src/services/rebalanceService.ts",
    "src/services/procurementService.ts"
  ]
}
