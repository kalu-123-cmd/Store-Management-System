# ─────────────────────────────────────────────────────────────────
# SmartStore OS — Server Environment Configuration Template
# Copy this file to .env and fill in real values before running.
#
#   cp .env.example .env
#
# NEVER commit .env to source control — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# SQLite (default for development and Render deployment)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (use in production for concurrency and locking support)
# DATABASE_URL="postgresql://user:password@localhost:5432/storeos?schema=public"

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Trust proxy headers (set to true behind Nginx/load balancer)
TRUST_PROXY=false

# ── JWT Authentication ────────────────────────────────────────────
# REQUIRED: Must be set in production. Minimum 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server will refuse to start in production if this is not set.
JWT_SECRET=REPLACE_ME_with_a_long_random_secret_minimum_32_characters

# ── CORS ──────────────────────────────────────────────────────────
# Frontend URL — set to your Vercel URL in production
CLIENT_URL=http://localhost:5173

# ── Email Notifications (optional) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ── Redis (optional — used by BullMQ for background jobs) ─────────
# Leave empty to disable background job processing
REDIS_URL=redis://localhost:6379

# ── OpenAI (optional — used by AI Dashboard) ─────────────────────
# Leave empty to disable AI features
OPENAI_API_KEY=

# ── Render-specific ───────────────────────────────────────────────
# Set automatically by Render — do not set manually
# RENDER=true
